<?xml version="1.0" encoding="utf-8" ?>
<basewin:BaseWindow
    x:Class="mpv_winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:basewin="using:mpv_winui.Modules.Common.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Body">
        <Grid.RowDefinitions>
            <RowDefinition
                x:Name="TitleBarRow"
                Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="ShellTitleBar">
            <TitleBar.IconSource>
                <BitmapIconSource
                    ShowAsMonochrome="False"
                    UriSource="App.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame
            x:Name="ShellFrame"
            Grid.Row="1"
            Grid.RowSpan="1" />

    </Grid>

</basewin:BaseWindow>