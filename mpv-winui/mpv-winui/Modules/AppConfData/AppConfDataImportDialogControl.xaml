<UserControl
    x:Class="mpv_winui.Modules.AppConfData.AppConfDataImportDialogControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.AppConfData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="480"
    mc:Ignorable="d">

    <Grid
        MinWidth="440"
        MaxWidth="640"
        ColumnSpacing="8"
        RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="ImportButton"
            Grid.Row="0"
            Grid.Column="0"
            Click="ImportButton_Click"
            Content="Import" />
        <HyperlinkButton
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Content="Download"
            NavigateUri="https://github.com/ikas-mc/mpv-winui-player/wiki/App-Data-Sample" />
        <Button
            x:Name="ToggleSelectButton"
            Grid.Row="0"
            Grid.Column="3"
            HorizontalAlignment="Right"
            Click="ToggleSelectButton_Click">
            <FontIcon Glyph="&#xE8B3;" />
        </Button>
        <Button
            x:Name="RefreshButton"
            Grid.Row="0"
            Grid.Column="4"
            HorizontalAlignment="Right"
            Click="RefreshButton_Click"
            IsEnabled="False">
            <FontIcon Glyph="&#xE72C;" />
        </Button>
        <TreeView
            x:Name="ConfDataTree"
            Grid.Row="1"
            Grid.ColumnSpan="5"
            ItemsSource="{x:Bind Nodes, Mode=OneWay}"
            SelectionMode="Multiple">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:AppConfDataNode">
                    <TreeViewItem
                        Height="32"
                        Padding="0,0,12,0"
                        IsExpanded="True"
                        ItemsSource="{x:Bind Children}">
                        <Grid
                            ColumnDefinitions="24,*,Auto"
                            ColumnSpacing="4">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Glyph="{x:Bind Glyph}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="exists"
                                Visibility="{x:Bind Exists}" />
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <CheckBox
            x:Name="ForceOverwriteCheckBox"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            VerticalAlignment="Center"
            Content="Force overwrite existing files" />
        <Button
            x:Name="ApplyButton"
            Grid.Row="2"
            Grid.Column="2"
            HorizontalAlignment="Right"
            Click="ApplyButton_Click"
            Content="Apply"
            IsEnabled="False"
            Style="{StaticResource AccentButtonStyle}" />

        <Button
            x:Name="RestartButton"
            Grid.Row="2"
            Grid.Column="3"
            HorizontalAlignment="Right"
            Click="RestartButton_Click"
            Content="Restart" />

        <Button
            x:Name="OpenTargetFolderButton"
            Grid.Row="2"
            Grid.Column="4"
            HorizontalAlignment="Right"
            Click="OpenTargetFolderButton_Click"
            ToolTipService.ToolTip="Open App Data Folder">
            <FontIcon Glyph="&#xE8DA;" />
        </Button>

        <ProgressRing
            x:Name="ImportProgressRing"
            Grid.Row="2"
            Grid.Column="2"
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Grid.ColumnSpan="5"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextSelectionEnabled="True"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>