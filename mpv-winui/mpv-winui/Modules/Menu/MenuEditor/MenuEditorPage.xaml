<Page
    x:Class="mpv_winui.Modules.Menu.MenuEditor.MenuEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Menu.MenuEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="EditorRowStyle"
            TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <MenuFlyout x:Key="TreeContextMenu">
            <MenuFlyoutItem
                Click="TreeContextMenu_Click"
                Tag="edit"
                Text="Edit">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="TreeContextMenu_Click"
                Tag="execute"
                Text="Execute">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="TreeContextMenu_Click"
                Tag="delete"
                Text="Delete">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="TreeContextMenu_Click"
                Tag="delete-children"
                Text="Delete children">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="TreeContextMenu_Click"
                Tag="add-child"
                Text="Add child">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid
        ColumnSpacing="8"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="*"
                MinWidth="220" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <CommandBar
            Grid.Row="0"
            Grid.Column="1"
            Margin="8,0"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="False">
            <AppBarButton
                x:Name="SaveButton"
                Click="SaveButton_Click"
                Label="Save"
                Style="{StaticResource SquareAppBarButtonStyle}"
                ToolTipService.ToolTip="Save">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="ReloadButton"
                Click="ReloadButton_Click"
                Label="Reload"
                Style="{StaticResource SquareAppBarButtonStyle}"
                ToolTipService.ToolTip="Reload">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="PreviewButton_Click"
                Label="Preview"
                Style="{StaticResource SquareAppBarButtonStyle}"
                ToolTipService.ToolTip="Rebuild preview menu">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE890;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <CommandBar
            Grid.Row="0"
            Grid.Column="0"
            Margin="8,0"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="False">
            <AppBarButton
                HorizontalAlignment="Left"
                Click="AddRootButton_Click"
                Label="Add root"
                Style="{StaticResource SquareAppBarButtonStyle}"
                ToolTipService.ToolTip="Add root node">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <TreeView
            x:Name="MenuTree"
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="8,0,0,0"
            AllowDrop="True"
            CanDragItems="True"
            ContextRequested="MenuTree_ContextRequested"
            DragItemsStarting="MenuTree_DragItemsStarting"
            DragOver="MenuTree_DragOver"
            Drop="MenuTree_Drop"
            ItemsSource="{x:Bind Nodes}"
            SelectionChanged="MenuTree_SelectionChanged">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:MenuTreeItem">
                    <TreeViewItem
                        Height="32"
                        ItemsSource="{x:Bind Children}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <BreadcrumbBar
            x:Name="Breadcrumb"
            Grid.Row="1"
            Grid.Column="1"
            ItemsSource="{x:Bind BreadcrumbItems}" />

        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8">
            <RadioButton
                x:Name="KindSubmenuRadio"
                Checked="KindRadio_Checked"
                Content="Menu (sub)"
                GroupName="NodeKind" />
            <RadioButton
                x:Name="KindMenuItemRadio"
                Checked="KindRadio_Checked"
                Content="Menu (cmd)"
                GroupName="NodeKind" />
            <RadioButton
                x:Name="KindSeparatorRadio"
                Checked="KindRadio_Checked"
                Content="Separator"
                GroupName="NodeKind" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="3"
            Grid.Column="1"
            Padding="0,0,12,0">
            <StackPanel Spacing="8">
                <Border
                    x:Name="NameRow"
                    Style="{StaticResource EditorRowStyle}">
                    <TextBox
                        x:Name="NameBox"
                        Header="Name"
                        TextChanged="NameBox_TextChanged" />
                </Border>

                <Border
                    x:Name="CommandRow"
                    Style="{StaticResource EditorRowStyle}">
                    <TextBox
                        x:Name="CommandBox"
                        Header="Command"
                        PlaceholderText="mpv command"
                        TextChanged="CommandBox_TextChanged" />
                </Border>

                <Border
                    x:Name="HiddenRow"
                    Style="{StaticResource EditorRowStyle}">
                    <TextBox
                        x:Name="HiddenBox"
                        Header="hidden"
                        PlaceholderText="expression"
                        TextChanged="StateBox_TextChanged" />
                </Border>

                <Border
                    x:Name="DisabledRow"
                    Style="{StaticResource EditorRowStyle}">
                    <TextBox
                        x:Name="DisabledBox"
                        Header="disabled"
                        PlaceholderText="expression"
                        TextChanged="StateBox_TextChanged" />
                </Border>

                <Border
                    x:Name="CheckedRow"
                    Style="{StaticResource EditorRowStyle}">
                    <TextBox
                        x:Name="CheckedBox"
                        Header="checked"
                        PlaceholderText="expression"
                        TextChanged="StateBox_TextChanged" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="8,0"
            Padding="4"
            CornerRadius="4">
            <MenuBar
                x:Name="PreviewBar"
                HorizontalAlignment="Right" />
            <Button
                x:Name="PreviewMenuButton"
                HorizontalAlignment="Right"
                Click="PreviewMenuButton_Click"
                Content="Right-click menu preview" />
        </Grid>

        <Border
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0"
            Background="{ThemeResource NavContentBackGroundColor}">
            <TextBlock
                x:Name="MessageBar"
                Margin="12,0,8,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EditorStates">
                <VisualState x:Name="EditorNone">
                    <VisualState.Setters>
                        <Setter Target="NameRow.Visibility" Value="Collapsed" />
                        <Setter Target="CommandRow.Visibility" Value="Collapsed" />
                        <Setter Target="HiddenRow.Visibility" Value="Collapsed" />
                        <Setter Target="DisabledRow.Visibility" Value="Collapsed" />
                        <Setter Target="CheckedRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EditorMenuItemMpv">
                    <VisualState.Setters>
                        <Setter Target="NameRow.Visibility" Value="Visible" />
                        <Setter Target="CommandRow.Visibility" Value="Visible" />
                        <Setter Target="HiddenRow.Visibility" Value="Visible" />
                        <Setter Target="DisabledRow.Visibility" Value="Visible" />
                        <Setter Target="CheckedRow.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EditorMenuItemMenubar">
                    <VisualState.Setters>
                        <Setter Target="NameRow.Visibility" Value="Visible" />
                        <Setter Target="CommandRow.Visibility" Value="Visible" />
                        <Setter Target="HiddenRow.Visibility" Value="Collapsed" />
                        <Setter Target="DisabledRow.Visibility" Value="Collapsed" />
                        <Setter Target="CheckedRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EditorSubmenu">
                    <VisualState.Setters>
                        <Setter Target="NameRow.Visibility" Value="Visible" />
                        <Setter Target="CommandRow.Visibility" Value="Collapsed" />
                        <Setter Target="HiddenRow.Visibility" Value="Collapsed" />
                        <Setter Target="DisabledRow.Visibility" Value="Collapsed" />
                        <Setter Target="CheckedRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EditorSeparator">
                    <VisualState.Setters>
                        <Setter Target="NameRow.Visibility" Value="Collapsed" />
                        <Setter Target="CommandRow.Visibility" Value="Collapsed" />
                        <Setter Target="HiddenRow.Visibility" Value="Collapsed" />
                        <Setter Target="DisabledRow.Visibility" Value="Collapsed" />
                        <Setter Target="CheckedRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PreviewStates">
                <VisualState x:Name="PreviewMenubar">
                    <VisualState.Setters>
                        <Setter Target="PreviewBar.Visibility" Value="Visible" />
                        <Setter Target="PreviewMenuButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PreviewMpvMenu">
                    <VisualState.Setters>
                        <Setter Target="PreviewBar.Visibility" Value="Collapsed" />
                        <Setter Target="PreviewMenuButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
