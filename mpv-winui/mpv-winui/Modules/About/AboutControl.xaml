<UserControl
    x:Class="mpv_winui.Modules.About.AboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel
        MinWidth="400"
        Spacing="8">
        <TextBlock
            x:Name="AppNameTextBlock"
            FontSize="20"
            FontWeight="SemiBold" />
        <TextBlock x:Name="AppVersionTextBlock" />

        <TextBlock
            Margin="0,4,0,0"
            Text="mpvw" />
        <HyperlinkButton
            Padding="0"
            HorizontalAlignment="Left"
            Content="https://github.com/ikas-mc/mpv-winui-player"
            NavigateUri="https://github.com/ikas-mc/mpv-winui-player" />

        <TextBlock x:Name="MpvVersionTextBlock" />
        <HyperlinkButton
            Padding="0"
            HorizontalAlignment="Left"
            Content="https://github.com/mpv-player/mpv"
            NavigateUri="https://github.com/mpv-player/mpv" />

        <HyperlinkButton
            Margin="0,4,0,0"
            Padding="0"
            HorizontalAlignment="Right"
            Content="Licensed under the GPLv3"
            NavigateUri="https://github.com/ikas-mc/mpv-winui-player#license" />
    </StackPanel>
</UserControl>