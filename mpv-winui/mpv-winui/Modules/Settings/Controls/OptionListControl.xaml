<UserControl
    x:Class="mpv_winui.Modules.Settings.Controls.OptionListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="BooleanTemplate">
            <ctl:OptionBooleanControl Margin="0,0,0,2" />
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <ctl:OptionStringControl Margin="0,0,0,2" />
        </DataTemplate>

        <DataTemplate x:Key="IntegerTemplate">
            <ctl:OptionIntegerControl Margin="0,0,0,2" />
        </DataTemplate>

        <DataTemplate x:Key="DoubleTemplate">
            <ctl:OptionDoubleControl Margin="0,0,0,2" />
        </DataTemplate>

        <DataTemplate x:Key="TextListTemplate">
            <ctl:OptionStringListControl Margin="0,0,0,2" />
        </DataTemplate>

        <ctl:OptionTemplateSelector
            x:Key="TemplateSelector"
            BooleanTemplate="{StaticResource BooleanTemplate}"
            DoubleTemplate="{StaticResource DoubleTemplate}"
            IntegerTemplate="{StaticResource IntegerTemplate}"
            TextListTemplate="{StaticResource TextListTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />

        <Style
            x:Key="OptionListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ListView
            x:Name="OptionListView"
            Grid.Row="1"
            Padding="0,0,12,0"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource OptionListViewItemStyle}"
            ItemTemplateSelector="{StaticResource TemplateSelector}"
            ItemsSource="{x:Bind OptionListSource.View, Mode=OneWay}"
            SelectionMode="None">
            <ListView.Resources>
                <CollectionViewSource
                    x:Name="OptionListSource"
                    IsSourceGrouped="True"
                    ItemsPath="Options" />
            </ListView.Resources>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="ctl:OptionGroup">
                            <TextBlock
                                Margin="0,0,0,0"
                                FontWeight="SemiBold"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneTime}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,0" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewHeaderItem">
                                        <Grid
                                            x:Name="RootGrid"
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                            <ContentPresenter
                                                x:Name="ContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                                Foreground="{TemplateBinding Foreground}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.Footer>
                <ContentControl
                    Padding="4,0,4,0"
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind Footer, Mode=OneWay}" />
            </ListView.Footer>
        </ListView>
    </Grid>
</UserControl>
