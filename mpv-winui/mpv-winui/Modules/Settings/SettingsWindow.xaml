<Window
    x:Class="mpv_winui.Modules.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:mpv_winui.Modules.Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Padding="16,8">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Settings" />
            </Border>
            <Frame
                x:Name="PageFrame"
                Grid.Row="1"
                Loaded="PageFrame_Loaded" />
        </Grid>
    </Grid>
</Window>