<basewin:BaseWindow
    x:Class="mpv_winui.Modules.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:basewin="using:mpv_winui.Modules.Common.View"
    xmlns:r="using:mpv_winui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Padding="12,8">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="{x:Bind r:AppContext.AppLang.Settings}" />
        </Border>
        <Frame
            x:Name="PageFrame"
            Grid.Row="1"
            Loaded="PageFrame_Loaded" />
    </Grid>
</basewin:BaseWindow>