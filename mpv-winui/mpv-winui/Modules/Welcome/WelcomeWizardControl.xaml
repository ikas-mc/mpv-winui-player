<UserControl
    x:Class="mpv_winui.Modules.Welcome.WelcomeWizardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:mpv_winui"
    mc:Ignorable="d">
    <StackPanel Spacing="12">
        <TextBlock
            Text="{x:Bind r:AppContext.AppLang.WelcomeThanks}"
            TextWrapping="Wrap" />
        <HyperlinkButton
            Padding="0"
            HorizontalAlignment="Left"
            Content="{x:Bind r:AppContext.AppLang.WelcomeProjectWiki}"
            NavigateUri="https://github.com/ikas-mc/mpv-winui-player/wiki" />
        <HyperlinkButton
            Padding="0"
            HorizontalAlignment="Left"
            Content="{x:Bind r:AppContext.AppLang.WelcomeProjectSource}"
            NavigateUri="https://github.com/ikas-mc/mpv-winui-player" />
        <TextBlock
            Text="{x:Bind r:AppContext.AppLang.WelcomeQuickStart}"
            TextWrapping="Wrap" />
        <Button
            x:Name="ImportSampleDataButton"
            HorizontalAlignment="Stretch"
            Click="ImportSampleDataButton_Click"
            Content="{x:Bind r:AppContext.AppLang.WelcomeImportAppConfData}"
            Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</UserControl>
