<UserControl
    x:Class="mpv_winui.Modules.Language.LanguageSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="using:mpv_winui.Modules.Language"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:mpv_winui"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid
        MinWidth="380"
        ColumnSpacing="16"
        RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox
            x:Name="LanguageComboBox"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            SelectionChanged="LanguageComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="lang:LangInfo">
                    <TextBlock Text="{x:Bind DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,4"
            HorizontalAlignment="Right"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind r:AppContext.AppLang.LanguageRestartRequired}" />

        <TextBlock
            Grid.Row="2"
            Padding="2,0,0,0"
            Text="{x:Bind r:AppContext.AppLang.LanguageReload}" />
        <Button
            Grid.Row="2"
            Grid.Column="1"
            Click="ReloadButton_Click">
            <FontIcon
                FontSize="16"
                Glyph="&#xE72C;" />
        </Button>

        <TextBlock
            Grid.Row="3"
            Padding="2,0,0,0"
            Text="{x:Bind r:AppContext.AppLang.LanguageExport}" />
        <Button
            Grid.Row="3"
            Grid.Column="1"
            Click="ExportButton_Click">
            <FontIcon
                FontSize="16"
                Glyph="&#xEDE1;" />
        </Button>

        <TextBlock
            Grid.Row="4"
            Padding="2,0,0,0"
            Text="{x:Bind r:AppContext.AppLang.LanguageImport}" />
        <Button
            Grid.Row="4"
            Grid.Column="1"
            Click="ImportButton_Click">
            <FontIcon
                FontSize="16"
                Glyph="&#xE8B5;" />
        </Button>

        <TextBlock
            Grid.Row="5"
            Padding="2,0,0,0"
            Text="{x:Bind r:AppContext.AppLang.LanguageOpenFolder}" />
        <Button
            Grid.Row="5"
            Grid.Column="1"
            Click="OpenFolderButton_Click">
            <FontIcon
                FontSize="16"
                Glyph="&#xE838;" />
        </Button>

        <TextBlock
            Grid.Row="6"
            Padding="2,0,0,0"
            Text="{x:Bind r:AppContext.AppLang.LanguageRestartApp}" />
        <Button
            Grid.Row="6"
            Grid.Column="1"
            Click="RestartButton_Click">
            <FontIcon
                FontSize="16"
                Glyph="&#xE7E8;" />
        </Button>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="7"
            Grid.ColumnSpan="2"
            Padding="2,0,0,0"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
