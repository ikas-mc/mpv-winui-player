<UserControl
    x:Class="mpv_winui.Modules.Player.PlayerControl.VolumeFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <AppBarButton
            x:Name="MuteButton"
            Width="40"
            HorizontalAlignment="Center"
            Click="MuteButton_Click"
            IsTabStop="False"
            LabelPosition="Collapsed">
            <AppBarButton.Icon>
                <FontIcon x:Name="VolumeIcon" />
            </AppBarButton.Icon>
        </AppBarButton>
        <Slider
            x:Name="VolumeSlider"
            Height="100"
            HorizontalAlignment="Center"
            IsTabStop="False"
            Maximum="100"
            Minimum="0"
            Orientation="Vertical"
            ValueChanged="VolumeSlider_ValueChanged" />
    </StackPanel>
</UserControl>
