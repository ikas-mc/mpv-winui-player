<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:player="using:mpv_winui.Modules.Player.PlayerControl"
    xmlns:ycc="using:mpv_winui.Modules.Common.View.Controls"
    mc:Ignorable="d">
    <Style
        x:Key="CompactPlayerControlStyle"
        TargetType="player:PlayerControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="player:PlayerControl">
                    <Grid
                        x:Name="ControlPanelGrid"
                        Padding="4"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource MpvPlayControlBackground}"
                        RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TranslateVertical" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="BufferingProgressBar"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Height="4"
                            Margin="8,0,8,0"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            IsIndeterminate="True"
                            ShowPaused="True"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="ErrorBorder"
                            Grid.Column="1"
                            MinWidth="220"
                            MaxWidth="320"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource MpvControlBackground}"
                            Canvas.ZIndex="99"
                            CornerRadius="4"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ErrorTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="Red"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="&#x26D4;"
                                TextWrapping="WrapWholeWords" />
                        </Border>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Name="PlayPauseButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="PlayPauseSymbol"
                                        FontSize="16"
                                        Glyph="&#xF5B0;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="PreviousTrackButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        FontSize="16"
                                        Glyph="&#xF8AC;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="NextTrackButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        FontSize="16"
                                        Glyph="&#xF8AD;" />
                                </Button.Content>
                            </Button>
                        </StackPanel>

                        <Grid
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <ycc:TickBar
                                    x:Name="ProgressTickBar"
                                    Height="8"
                                    Margin="7,0,7,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    TickBrush="{ThemeResource SystemAccentColor2Brush}" />
                                <Slider
                                    x:Name="ProgressSlider"
                                    MinWidth="80"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    IsThumbToolTipEnabled="False" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <TextBlock
                                    x:Name="TimeElapsedElement"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="00:00" />
                                <TextBlock
                                    x:Name="TimeSeparatorElement"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="/" />
                                <TextBlock
                                    x:Name="TimeDurationElement"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="00:00" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Name="VolumeMuteButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="AudioMuteSymbol"
                                        FontSize="16"
                                        Glyph="&#xE995;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="FullWindowButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="FullWindowSymbol"
                                        FontSize="16"
                                        Glyph="&#xF16B;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="FullScreenButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="FullScreenSymbol"
                                        FontSize="16"
                                        Glyph="&#xE740;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="MoreButton"
                                IsTabStop="False"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        FontSize="16"
                                        Glyph="&#xE10C;" />
                                </Button.Content>
                                <Button.Flyout>
                                    <MenuFlyout
                                        x:Name="MoreFlyout"
                                        Placement="Top">
                                        <MenuFlyoutItem
                                            x:Name="MoreSkipBackward"
                                            Text="Skip Backward">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED3C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreSkipForward"
                                            Text="Skip Forward">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED3D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreShuffle"
                                            Text="Shuffle">
