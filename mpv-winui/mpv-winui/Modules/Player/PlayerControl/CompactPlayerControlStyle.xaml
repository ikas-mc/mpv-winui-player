L 11.24 10.919999 C 12.013332 10.253333 12.759998 9.76 13.48 9.44 C 14.359999 9.04 15.293332 8.826666 16.279999 8.799999 L 15.16 9.959999 C 15.053332 10.04 14.999999 10.153334 15 10.299999 C 14.999999 10.446667 15.046665 10.566667 15.139999 10.66 C 15.233332 10.753333 15.353333 10.799999 15.5 10.799999 C 15.646666 10.799999 15.759998 10.746666 15.839999 10.639999 L 17.84 8.639999 C 17.946667 8.559999 18 8.446667 18 8.299999 C 18 8.153334 17.946667 8.04 17.84 7.959999 L 15.839999 5.96 C 15.759998 5.853333 15.646666 5.799999 15.5 5.799999 C 15.353333 5.799999 15.233332 5.846666 15.139999 5.94 C 15.046665 6.033334 14.999999 6.153334 15 6.299999 C 14.999999 6.446667 15.053332 6.56 15.16 6.639999 L 16.279999 7.799999 C 15.133332 7.826666 14.039999 8.08 13 8.559999 C 12.226666 8.933334 11.4 9.48 10.52 10.2 Z " />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreRepeat"
                                            Text="Repeat">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    x:Name="MoreRepeatIcon"
                                                    Glyph="&#xE8EE;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator x:Name="MoreTransportSep" />
                                        <MenuFlyoutSubItem
                                            x:Name="MorePlaybackRate"
                                            Text="Playback Rate">
                                            <MenuFlyoutSubItem.Icon>
                                                <FontIcon Glyph="&#xEC57;" />
                                            </MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem
                                                Tag="0.1"
                                                Text="0.1x" />
                                            <MenuFlyoutItem
                                                Tag="0.25"
                                                Text="0.25x" />
                                            <MenuFlyoutItem
                                                Tag="0.5"
                                                Text="0.5x" />
                                            <MenuFlyoutItem
                                                Tag="0.75"
                                                Text="0.75x" />
                                            <MenuFlyoutItem
                                                Tag="1.0"
                                                Text="1.0x" />
                                            <MenuFlyoutItem
                                                Tag="1.25"
                                                Text="1.25x" />
                                            <MenuFlyoutItem
                                                Tag="1.5"
                                                Text="1.5x" />
                                            <MenuFlyoutItem
                                                Tag="1.75"
                                                Text="1.75x" />
                                            <MenuFlyoutItem
                                                Tag="2.0"
                                                Text="2.0x" />
                                            <MenuFlyoutItem
                                                Tag="4.0"
                                                Text="4.0x" />
                                            <MenuFlyoutItem
                                                Tag="8.0"
                                                Text="8.0x" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem
                                            x:Name="MoreZoom"
                                            Text="Zoom">
                                            <MenuFlyoutSubItem.Icon>
                                                <FontIcon Glyph="&#xE799;" />
                                            </MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem
                                                Tag="no"
                                                Text="Auto" />
                                            <MenuFlyoutItem
                                                Tag="4:3"
                                                Text="4:3" />
                                            <MenuFlyoutItem
                                                Tag="16:9"
                                                Text="16:9" />
                                            <MenuFlyoutItem
                                                Tag="16:10"
                                                Text="16:10" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem
                                            x:Name="MorePreviousTrack"
                                            Text="Previous Track"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreNextTrack"
                                            Text="Next Track"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF8AD;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator
                                            x:Name="MoreWindowSep"
                                            Visibility="Collapsed" />
                                        <MenuFlyoutItem
                                            x:Name="MoreFullWindow"
                                            Text="Full Window"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    x:Name="MoreFullWindowIcon"
                                                    Glyph="&#xF16B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreFullScreen"
                                            Text="Full Screen"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    x:Name="MoreFullScreenIcon"
                                                    Glyph="&#xE740;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MediaStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Buffering">
                                    <VisualState.Setters>
                                        <Setter Target="BufferingProgressBar.Visibility" Value="Visible" />
                                        <Setter Target="BufferingProgressBar.ShowPaused" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="ErrorBorder.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="PlayPauseStates">
                                <VisualState x:Name="PlayState" />
                                <VisualState x:Name="PauseState">
                                    <VisualState.Setters>
                                        <Setter Target="PlayPauseSymbol.Glyph" Value="&#xF8AE;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="VolumeMuteStates">
                                <VisualState x:Name="VolumeState" />
                                <VisualState x:Name="MuteState">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE74F;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState0">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE992;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState1">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE993;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState2">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE994;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState3">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE995;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FullScreenStates">
                                <VisualState x:Name="NonFullScreenState" />
                                <VisualState x:Name="FullScreenState">
                                    <VisualState.Setters>
                                        <Setter Target="FullScreenSymbol.Glyph" Value="&#xE73F;" />
                                        <Setter Target="MoreFullScreenIcon.Glyph" Value="&#xE72B;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FullWindowStates">
                                <VisualState x:Name="NonFullWindowState" />
                                <VisualState x:Name="FullWindowState">
                                    <VisualState.Setters>
                                        <Setter Target="FullWindowSymbol.Glyph" Value="&#xE745;" />
                                        <Setter Target="MoreFullWindowIcon.Glyph" Value="&#xE745;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="RepeatStates">
                                <VisualState x:Name="RepeatAllState" />
                                <VisualState x:Name="RepeatNoneState">
                                    <VisualState.Setters>
                                        <Setter Target="MoreRepeatIcon.Glyph" Value="&#xF5E7;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="RepeatOneState">
                                    <VisualState.Setters>
                                        <Setter Target="MoreRepeatIcon.Glyph" Value="&#xE8ED;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ShuffleStates">
                                <VisualState x:Name="ShuffleNoneState" />
                                <VisualState x:Name="ShuffleState">
