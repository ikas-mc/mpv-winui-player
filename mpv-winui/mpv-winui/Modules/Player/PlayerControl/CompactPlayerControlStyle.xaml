                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ControlPanelVisibilityStates">
                                <VisualState x:Name="ControlPanelFadeIn">
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanelGrid.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <FadeInThemeAnimation TargetName="ControlPanelGrid" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ControlPanelFadeOut">
                                    <Storyboard>
                                        <FadeOutThemeAnimation TargetName="ControlPanelGrid" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanelGrid.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="WidthAdaptiveStates">
                                <VisualState x:Name="Wide" />
                                <VisualState x:Name="Medium" />
                                <VisualState x:Name="Compact">
                                    <VisualState.Setters>
                                        <Setter Target="FullWindowButton.Visibility" Value="Collapsed" />
                                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                                        <Setter Target="MoreFullWindow.Visibility" Value="Visible" />
                                        <Setter Target="MoreFullScreen.Visibility" Value="Visible" />
                                        <Setter Target="MoreWindowSep.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Narrow">
                                    <VisualState.Setters>
                                        <Setter Target="PreviousTrackButton.Visibility" Value="Collapsed" />
                                        <Setter Target="NextTrackButton.Visibility" Value="Collapsed" />
                                        <Setter Target="TimeDurationElement.Visibility" Value="Collapsed" />
                                        <Setter Target="TimeSeparatorElement.Visibility" Value="Collapsed" />
                                        <Setter Target="ProgressTickBar.Visibility" Value="Collapsed" />
                                        <Setter Target="ProgressSlider.Visibility" Value="Collapsed" />
                                        <Setter Target="FullWindowButton.Visibility" Value="Collapsed" />
                                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                                        <Setter Target="MorePreviousTrack.Visibility" Value="Visible" />
                                        <Setter Target="MoreNextTrack.Visibility" Value="Visible" />
                                        <Setter Target="MoreFullWindow.Visibility" Value="Visible" />
                                        <Setter Target="MoreFullScreen.Visibility" Value="Visible" />
                                        <Setter Target="MoreWindowSep.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
