                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="RepeatButton"
                        Grid.Column="10"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="RepeatSymbol"
                                Glyph="&#xE8EE;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                </CommandBar>

                <CommandBar
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Collapsed"
                    Style="{StaticResource CommandBarWithoutRevealStyle}">

                    <CommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                        <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                        <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="VolumeMuteButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Resources>
                            <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                            <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        </AppBarButton.Resources>
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="AudioMuteSymbol"
                                Glyph="&#xE995;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarElementContainer>
                        <ycc:SliderExt
                            x:Name="VolumeSlider"
                            Width="100"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsThumbToolTipEnabled="False"
                            SmallChange="10"
                            Value="50" />
                    </AppBarElementContainer>

                    <AppBarButton
                        x:Name="InfoButton"
                        Grid.Column="10"
                        x:FieldModifier="public"
                        Label="Info"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="PlaybackRateButton"
                        Grid.Column="9"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEC57;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="PlaybackRateFlyout"
                                LightDismissOverlayMode="Off"
                                Placement="Top">
                                <MenuFlyoutItem
                                    Tag="0.1"
                                    Text="0.1x" />
                                <MenuFlyoutItem
                                    Tag="0.25"
                                    Text="0.25x" />
                                <MenuFlyoutItem
                                    Tag="0.5"
                                    Text="0.5x" />
                                <MenuFlyoutItem
                                    Tag="0.75"
                                    Text="0.75x" />
                                <MenuFlyoutItem
                                    Tag="1.0"
                                    Text="1.0x" />
                                <MenuFlyoutItem
                                    Tag="1.25"
                                    Text="1.25x" />
                                <MenuFlyoutItem
                                    Tag="1.5"
                                    Text="1.5x" />
                                <MenuFlyoutItem
                                    Tag="1.75"
                                    Text="1.75x" />
                                <MenuFlyoutItem
                                    Tag="2.0"
                                    Text="2.0x" />
                                <MenuFlyoutItem
                                    Tag="4.0"
                                    Text="4.0x" />
                                <MenuFlyoutItem
                                    Tag="8.0"
                                    Text="8.0x" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="TrackSelectionButton"
                        Grid.Column="13"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xED1F;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="TrackSelectionFlyout"
                                Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style
                                        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                                        TargetType="FlyoutPresenter">
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Setter Property="TabNavigation" Value="Cycle" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="IsDefaultShadowEnabled" Value="True" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <local:PlayerTrackSelectorControl />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ZoomButton"
                        Grid.Column="15"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE799;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="ZoomSelectionFlyout"
                                LightDismissOverlayMode="Off"
                                Placement="Top">
                                <MenuFlyoutItem Text="" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="FullWindowButton"
                        Grid.Column="18"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="FullWindowSymbol"
                                Glyph="&#xF16B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="FullScreenButton"
                        Grid.Column="18"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <SymbolIcon
                                x:Name="FullScreenSymbol"
                                Symbol="FullScreen" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands />
                </CommandBar>
            </Grid>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MediaStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Buffering">
                    <VisualState.Setters>
                        <Setter Target="BufferingProgressBar.Visibility" Value="Visible" />
                        <Setter Target="BufferingProgressBar.ShowPaused" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediaLoading">
                    <VisualState.Setters>
                        <Setter Target="BufferingProgressBar.Visibility" Value="Visible" />
                        <Setter Target="BufferingProgressBar.ShowPaused" Value="False" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="ProgressSlider"
                            Storyboard.TargetProperty="Opacity"
                            To="0.8"
                            Duration="0" />
                        <DoubleAnimation
                            Storyboard.TargetName="MediaControlsCommandBar"
                            Storyboard.TargetProperty="Opacity"
                            To="0.8"
                            Duration="0" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="ErrorBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                    <Storyboard />
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PlayPauseStates">
                <VisualState x:Name="PlayState" />
                <VisualState x:Name="PauseState">
                    <VisualState.Setters>
                        <Setter Target="PlayPauseSymbol.Glyph" Value="&#xF8AE;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="VolumeMuteStates">
                <VisualState x:Name="VolumeState" />
                <VisualState x:Name="MuteState">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE74F;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState0">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE992;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState1">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE993;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState2">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE994;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState3">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE995;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="FullScreenStates">
                <VisualState x:Name="NonFullScreenState" />
                <VisualState x:Name="FullScreenState">
                    <VisualState.Setters>
                        <Setter Target="FullScreenButton.Icon" Value="BackToWindow" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="FullWindowStates">
                <VisualState x:Name="NonFullWindowState" />
                <VisualState x:Name="FullWindowState">
                    <VisualState.Setters>
                        <Setter Target="FullWindowSymbol.Glyph" Value="&#xE745;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="RepeatStates">
                <VisualState x:Name="RepeatAllState" />
                <VisualState x:Name="RepeatNoneState">
                    <VisualState.Setters>
                        <Setter Target="RepeatSymbol.Glyph" Value="&#xF5E7;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RepeatOneState">
                    <VisualState.Setters>
                        <Setter Target="RepeatSymbol.Glyph" Value="&#xE8ED;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ShuffleStates">
                <VisualState x:Name="ShuffleNoneState" />
                <VisualState x:Name="ShuffleState">
