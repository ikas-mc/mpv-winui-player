                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="RepeatButton"
                        Grid.Column="10"
                        IsTabStop="False"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="RepeatSymbol"
                                Glyph="&#xE8EE;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                </CommandBar>

                <CommandBar
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="False"
                    Style="{StaticResource CommandBarWithoutRevealStyle}">

                    <CommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                        <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                        <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="VolumeMuteButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsTabStop="False"
                        PointerWheelChanged="VolumeMuteButton_PointerWheelChanged"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Resources>
                            <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                            <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        </AppBarButton.Resources>
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="AudioMuteSymbol"
                                Glyph="&#xE995;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarElementContainer x:Name="VolumeSliderContainer">
                        <ycc:SliderExt
                            x:Name="VolumeSlider"
                            Width="88"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            IsThumbToolTipEnabled="False"
                            SmallChange="10"
                            Value="50" />
                    </AppBarElementContainer>

                    <AppBarButton
                        x:Name="PlaybackRateButton"
                        Grid.Column="9"
                        IsTabStop="False"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEC57;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="PlaybackRateFlyout"
                                LightDismissOverlayMode="Off"
                                Placement="Top">
                                <MenuFlyoutItem
                                    Tag="0.1"
                                    Text="0.1x" />
                                <MenuFlyoutItem
                                    Tag="0.25"
                                    Text="0.25x" />
                                <MenuFlyoutItem
                                    Tag="0.5"
                                    Text="0.5x" />
                                <MenuFlyoutItem
                                    Tag="0.75"
                                    Text="0.75x" />
                                <MenuFlyoutItem
                                    Tag="1.0"
                                    Text="1.0x" />
                                <MenuFlyoutItem
                                    Tag="1.25"
                                    Text="1.25x" />
                                <MenuFlyoutItem
                                    Tag="1.5"
                                    Text="1.5x" />
                                <MenuFlyoutItem
                                    Tag="1.75"
                                    Text="1.75x" />
                                <MenuFlyoutItem
                                    Tag="2.0"
                                    Text="2.0x" />
                                <MenuFlyoutItem
                                    Tag="4.0"
                                    Text="4.0x" />
                                <MenuFlyoutItem
                                    Tag="8.0"
                                    Text="8.0x" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="TrackSelectionButton"
                        Grid.Column="13"
                        IsTabStop="False"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xED1F;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="TrackSelectionFlyout"
                                Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style
                                        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                                        TargetType="FlyoutPresenter">
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="TabNavigation" Value="Cycle" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MaxWidth" Value="480" />
                                        <Setter Property="MaxHeight" Value="480" />
                                        <Setter Property="IsDefaultShadowEnabled" Value="True" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColor}" />
                                        <Setter Property="Background" Value="{ThemeResource MpvControlBackground}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <local:PlayerTrackSelectorControl x:Name="TrackSelectorControl" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ZoomButton"
                        Grid.Column="15"
                        IsTabStop="False"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE799;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="ZoomSelectionFlyout"
                                LightDismissOverlayMode="Off"
                                Placement="Top">
                                <MenuFlyoutItem Text="" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="FullWindowButton"
                        Grid.Column="18"
                        IsTabStop="False"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="FullWindowSymbol"
                                Glyph="&#xF16B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="FullScreenButton"
                        Grid.Column="18"
                        IsTabStop="False"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <SymbolIcon
                                x:Name="FullScreenSymbol"
                                Symbol="FullScreen" />
                        </AppBarButton.Icon>
                    </AppBarButton>

