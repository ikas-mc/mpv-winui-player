<UserControl
    x:Class="mpv_winui.Modules.Player.PlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:ycc="using:mpv_winui.Modules.Common.View.Controls"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style
                x:Key="AppBarButtonStyle"
                BasedOn="{StaticResource DefaultAppBarButtonStyle}"
                TargetType="AppBarButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="AllowFocusOnInteraction" Value="True" />
            </Style>
            <Style
                x:Key="AppBarToggleButtonStyle"
                BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}"
                TargetType="AppBarToggleButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="AllowFocusOnInteraction" Value="True" />
            </Style>
        </Grid.Resources>
        <Grid
            x:Name="ControlPanelGrid"
            Padding="4,0"
            VerticalAlignment="Bottom"
            Background="{ThemeResource MpvPlayControlBackground}"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TranslateVertical" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="ErrorBorder"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Width="320"
                HorizontalAlignment="Center"
                Canvas.ZIndex="99"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorTextBlock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="⛔"
                    TextWrapping="WrapWholeWords" />
            </Border>
            <Grid
                x:Name="MediaTransportControls_Timeline_Grid"
                Grid.Row="1"
                Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider
                    x:Name="ProgressSlider"
                    MinWidth="80"
                    Margin="7,2,7,1"
                    VerticalAlignment="Center"
                    IsTabStop="False"
                    IsThumbToolTipEnabled="False" />
                <ProgressBar
                    x:Name="BufferingProgressBar"
                    Height="4"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource SystemAccentColorLight2}"
                    IsHitTestVisible="False"
                    IsIndeterminate="True"
                    ShowPaused="True"
                    Visibility="Collapsed" />
                <Grid
                    x:Name="TimeTextGrid"
                    Grid.Row="1"
                    Height="16"
                    Margin="7,0,7,2">
                    <TextBlock
                        x:Name="TimeElapsedElement"
                        Margin="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Text="00:00" />
                    <TextBlock
                        x:Name="TimeRemainingElement"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Text="00:00" />
                </Grid>
            </Grid>
            <Grid
                x:Name="MediaControlsCommandBar"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,3"
                HorizontalAlignment="Stretch">
                <Grid.Resources>
                    <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                    <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                    <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                    <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*"
                        MinWidth="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition
                        Width="*"
                        MinWidth="100" />
                </Grid.ColumnDefinitions>

                <CommandBar
                    Grid.Column="0"
                    Margin="-3,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    DefaultLabelPosition="Collapsed"
                    Style="{StaticResource CommandBarWithoutRevealStyle}">
                    <CommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                        <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                        <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="PlayPauseButton"
                        Grid.Column="1"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="PlayPauseSymbol"
                                Glyph="&#xF5B0;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="RewindButton"
                        Grid.Column="4"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE627;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="FastForwardButton"
                        Grid.Column="5"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE628;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="PreviousTrackButton"
                        Grid.Column="6"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF8AC;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="NextTrackButton"
                        Grid.Column="7"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF8AD;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="SkipBackwardButton"
                        Grid.Column="2"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xED3C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="SkipForwardButton"
                        Grid.Column="3"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xED3D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="StopButton"
                        Grid.Column="8"
                        Icon="Stop"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed" />

                    <AppBarButton
                        x:Name="ShuffleButton"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <PathIcon
                                x:Name="ShuffleSymbol"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
