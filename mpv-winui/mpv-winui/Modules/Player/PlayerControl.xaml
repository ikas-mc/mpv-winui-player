                                    Text="Repeat">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            x:Name="MoreRepeatIcon"
                                            Glyph="&#xE8EE;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="MoreTransportSep" />
