<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="mpv_winui.Modules.Player.MpvPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bc="using:mpv_winui.Modules.Common.Convertor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pc="using:mpv_winui.Modules.Player.PlayerControl"
    xmlns:preview="using:mpv_winui.Modules.Player.BuiltInPreview"
    xmlns:r="using:mpv_winui"
    mc:Ignorable="d">
    <Page.Resources>
        <MenuFlyout
            x:Key="PlaylistContextMenu"
            x:Name="PlaylistContextMenu">
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="play"
                Text="{x:Bind r:AppContext.AppLang.Play}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-top"
                Text="{x:Bind r:AppContext.AppLang.PlayerMoveToTop}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF090;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-up"
                Text="{x:Bind r:AppContext.AppLang.PlayerMoveUp}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-down"
                Text="{x:Bind r:AppContext.AppLang.PlayerMoveDown}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-bottom"
                Text="{x:Bind r:AppContext.AppLang.PlayerMoveToBottom}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF08E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="remove"
                Text="{x:Bind r:AppContext.AppLang.Remove}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-title"
                Text="{x:Bind r:AppContext.AppLang.PlayerCopyTitle}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-path"
                Text="{x:Bind r:AppContext.AppLang.PlayerCopyFilePath}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="open-location"
                Text="{x:Bind r:AppContext.AppLang.PlayerOpenFileLocation}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                x:Name="MenuRow"
                Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition
                x:Name="PlayControlRow"
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition
                x:Name="PlaylistColumn"
                Width="0"
                MaxWidth="300" />
        </Grid.ColumnDefinitions>
        <MenuBar
            x:Name="MainMenuBar"
            Grid.Row="0"
            Grid.ColumnSpan="1">
            <MenuBarItem
                Title="{x:Bind r:AppContext.AppLang.File}"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open"
                    Text="{x:Bind r:AppContext.AppLang.OpenFile}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-folder"
                    Text="{x:Bind r:AppContext.AppLang.OpenFolder}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-url"
                    Text="{x:Bind r:AppContext.AppLang.OpenUrl}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-clipboard"
                    Text="{x:Bind r:AppContext.AppLang.OpenFromClipboard}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-dvd"
                    Text="{x:Bind r:AppContext.AppLang.PlayerOpenDvd}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-bd"
                    Text="{x:Bind r:AppContext.AppLang.PlayerOpenBluRay}" />
                <MenuFlyoutSubItem Text="{x:Bind r:AppContext.AppLang.OpenDisc}">
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-cdda"
                        Text="{x:Bind r:AppContext.AppLang.PlayerOpenCd}" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-dvda"
                        Text="{x:Bind r:AppContext.AppLang.PlayerOpenDvda}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-cd-img"
                        Text="{x:Bind r:AppContext.AppLang.PlayerOpenCdImage}" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-dvd-img"
                        Text="{x:Bind r:AppContext.AppLang.PlayerOpenDvdImage}" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-dvda-img"
                        Text="{x:Bind r:AppContext.AppLang.PlayerOpenDvdaImage}" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-bd-img"
                        Text="{x:Bind r:AppContext.AppLang.PlayerOpenBdImage}" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-watch-history"
                    Text="{x:Bind r:AppContext.AppLang.PlayerOpenWatchHistory}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-watch-later"
                    Text="{x:Bind r:AppContext.AppLang.PlayerOpenWatchLater}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="load-subtitle"
                    Text="{x:Bind r:AppContext.AppLang.PlayerAddSubtitle}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot"
                    Text="{x:Bind r:AppContext.AppLang.PlayerScreenshot}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot-no-sub"
                    Text="{x:Bind r:AppContext.AppLang.PlayerScreenshotNoSubtitle}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="media-info"
                    Text="{x:Bind r:AppContext.AppLang.MediaInfo}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="restart"
                    Text="{x:Bind r:AppContext.AppLang.Restart}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="quit"
                    Text="{x:Bind r:AppContext.AppLang.Quit}" />
            </MenuBarItem>

            <MenuBarItem
                Title="{x:Bind r:AppContext.AppLang.View}"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="playlist"
                    Text="{x:Bind r:AppContext.AppLang.Playlist}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullwindow"
                    Text="{x:Bind r:AppContext.AppLang.PlayerFullWindow}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullscreen"
                    Text="{x:Bind r:AppContext.AppLang.PlayerFullScreen}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="ontop"
                    Text="{x:Bind r:AppContext.AppLang.PlayerAlwaysOnTop}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="options"
                    Text="{x:Bind r:AppContext.AppLang.Options}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="conf-edit"
                    Text="{x:Bind r:AppContext.AppLang.MpvConfEditor}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="edit-menu-mpv"
                    Text="{x:Bind r:AppContext.AppLang.PlayerMpvMenuEditor}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="edit-menu-menubar"
                    Text="{x:Bind r:AppContext.AppLang.PlayerMenuBarEditor}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="conf-folder"
                    Text="{x:Bind r:AppContext.AppLang.PlayerOpenAppDataFolder}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="mpv-folder"
                    Text="{x:Bind r:AppContext.AppLang.PlayerOpenMpvConfigFolder}" />
                <MenuFlyoutSubItem Text="{x:Bind r:AppContext.AppLang.Open}">
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpv-conf"
                        Text="mpv.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpvw-conf"
                        Text="mpvw.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-input-conf"
                        Text="input.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-menu-conf"
                        Text="menu.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpv-log"
                        Text="mpv.log" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpwv-menu-conf"
                        Text="mpvw-menu.conf" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="language"
                    Text="{x:Bind r:AppContext.AppLang.Language}" />
            </MenuBarItem>

            <MenuBarItem
                Title="{x:Bind r:AppContext.AppLang.Help}"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="about"
                    Text="{x:Bind r:AppContext.AppLang.About}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpv-wiki"
                    Text="{x:Bind r:AppContext.AppLang.PlayerMpvWiki}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpv-manual"
                    Text="{x:Bind r:AppContext.AppLang.PlayerMpvManual}" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpv-manual-stable"
                    Text="{x:Bind r:AppContext.AppLang.PlayerMpvManualStable}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpvw-wiki"
                    Text="{x:Bind r:AppContext.AppLang.PlayerMpvwWiki}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="import-conf-data"
                    Text="{x:Bind r:AppContext.AppLang.ImportData}" />
            </MenuBarItem>
        </MenuBar>

        <Grid
            x:Name="PlaylistContainer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Canvas.ZIndex="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CommandBar
                x:Name="PlaylistToolBar"
                Grid.Row="0"
                Height="44"
                Margin="8,0"
                HorizontalAlignment="Right"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False">
                <AppBarButton
                    Grid.Column="1"
                    Width="40"
                    Click="ClosePlaylist_Click"
                    Icon="ClosePane" />
                <AppBarButton
                    Grid.Column="1"
                    Width="40"
                    Click="RefreshPlaylist_Click"
                    Icon="Refresh" />
            </CommandBar>

            <ListView
                x:Name="PlaylistView"
                Grid.Row="1"
                Padding="4,0,8,4"
                Background="Transparent"
                BorderThickness="0"
                ContextRequested="PlaylistView_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="PlaylistView_ItemClick"
                ItemsSource="{x:Bind PlaylistItems, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style
                        BasedOn="{StaticResource DefaultListViewItemStyle}"
                        TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="16,8,8,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaylistItem">
                        <Grid
                            Height="28"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <FontIcon
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                FontSize="14"
                                Glyph="&#xE768;"
                                Visibility="{x:Bind IsCurrent}" />
                            <FontIcon
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                FontSize="14"
                                Glyph="&#xE8B2;"
                                Visibility="{x:Bind bc:BindConvertor.InvertVisibility(IsCurrent)}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Title}">
                                <Run Text="{x:Bind Index}" />
                                <Run Text="." />
                                <Run Text="{x:Bind Title}" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="10"
                                Opacity="0.8"
                                Text="{x:Bind Filename}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Filename}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            x:Name="VideoContainer"
            Grid.Row="1"
            Grid.Column="0"
            AllowDrop="True"
            Background="#22000000"
            DragEnter="OnDragEnter"
            DragOver="OnDragOver"
            Drop="OnDrop">
            <SwapChainPanel
                x:Name="PlayerView"
                ContextRequested="PlayerView_ContextRequested">
                <Border Background="Transparent" />
            </SwapChainPanel>
            <preview:MpvSoftwarePreviewControl
                x:Name="MpvPreview"
                Width="192"
                Height="108"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                x:Load="{x:Bind _enableBuiltInPreview}"
                Canvas.ZIndex="2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <preview:MpvSoftwarePreviewControl.RenderTransform>
                    <TranslateTransform x:Name="PreviewControlTranslation" />
                </preview:MpvSoftwarePreviewControl.RenderTransform>
            </preview:MpvSoftwarePreviewControl>
        </Grid>

        <pc:PlayerControl
            x:Name="PlayerControl"
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            NextTrackButtonVisibility="Visible"
            PreviousTrackButtonVisibility="Visible" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HidePlaylist">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="ShowPlaylist">
                    <VisualState.Setters>
                        <Setter Target="PlaylistContainer.Visibility" Value="Visible" />
                        <Setter Target="PlaylistColumn.Width" Value="1*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="NormalWindow">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="FullWindow">
                    <VisualState.Setters>
                        <Setter Target="PlayControlRow.Height" Value="0" />
                        <Setter Target="MenuRow.Height" Value="0" />
                        <Setter Target="PlayerControl.(Grid.Row)" Value="1" />
                        <Setter Target="PlaylistToolBar.HorizontalAlignment" Value="Left" />
                        <Setter Target="PlaylistToolBar.Margin" Value="4,-6,8,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
