<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="mpv_winui.Modules.Player.MpvPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bc="using:mpv_winui.Modules.Common.Convertor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="PlaylistContextMenu">
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="play"
                Text="Play">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-top"
                Text="Move to Top">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF090;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-up"
                Text="Move Up">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-down"
                Text="Move Down">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-bottom"
                Text="Move to Bottom">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF08E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="remove"
                Text="Remove">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-title"
                Text="Copy Title">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-path"
                Text="Copy File Path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="open-location"
                Text="Open File Location">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                x:Name="MenuRow"
                Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition
                x:Name="PlayControlRow"
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition
                x:Name="PlaylistColumn"
                Width="0"
                MaxWidth="300" />
        </Grid.ColumnDefinitions>
        <MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="1">
            <MenuBarItem
                Title="File"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open"
                    Text="Open File" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-folder"
                    Text="Open Folder" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-url"
                    Text="Open URL" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-clipboard"
                    Text="Open from Clipboard" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-dvd"
                    Text="Open DVD" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-bd"
                    Text="Open Blu-ray" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="load-subtitle"
                    Text="Add Subtitle" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot"
                    Text="Screenshot" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot-no-sub"
                    Text="Screenshot (No Subtitles)" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="restart"
                    Text="Restart" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="quit"
                    Text="Quit" />
            </MenuBarItem>

            <MenuBarItem
                Title="View"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="playlist"
                    Text="Playlist" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullwindow"
                    Text="Full Window" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullscreen"
                    Text="Full Screen" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="options"
                    Text="Options" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="conf-folder"
                    Text="Open Conf Folder" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="mpv-folder"
                    Text="Open mpv Folder" />
            </MenuBarItem>

            <MenuBarItem
                Title="Help"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="about"
                    Text="About" />
            </MenuBarItem>
        </MenuBar>

        <Grid
            x:Name="PlaylistContainer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Canvas.ZIndex="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CommandBar
                x:Name="PlaylistToolBar"
                Grid.Row="0"
                Height="44"
                Margin="8,0"
                HorizontalAlignment="Right"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False">
                <AppBarButton
                    Grid.Column="1"
                    Width="40"
                    Click="ClosePlaylist_Click"
                    Icon="ClosePane" />
                <AppBarButton
                    Grid.Column="1"
                    Width="40"
                    Click="RefreshPlaylist_Click"
                    Icon="Refresh" />
            </CommandBar>

            <ListView
                x:Name="PlaylistView"
                Grid.Row="1"
                Padding="4,0,8,4"
                Background="Transparent"
                BorderThickness="0"
                ContextRequested="PlaylistView_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="PlaylistView_ItemClick"
                ItemsSource="{x:Bind PlaylistItems, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style
                        BasedOn="{StaticResource DefaultListViewItemStyle}"
                        TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="16,8,8,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaylistItem">
                        <Grid
                            Height="28"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <FontIcon
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                FontSize="14"
                                Glyph="&#xE768;"
                                Visibility="{x:Bind IsCurrent}" />
                            <FontIcon
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                FontSize="14"
                                Glyph="&#xE8B2;"
                                Visibility="{x:Bind bc:BindConvertor.InvertVisibility(IsCurrent)}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Title}">
                                <Run Text="{x:Bind Index}" />
                                <Run Text="." />
                                <Run Text="{x:Bind Title}" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="10"
                                Opacity="0.8"
                                Text="{x:Bind Filename}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Filename}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            AllowDrop="True"
            Background="#22000000"
            DragEnter="OnDragEnter"
            DragOver="OnDragOver"
            Drop="OnDrop">
            <SwapChainPanel
                x:Name="PlayerView"
                ContextRequested="PlayerView_ContextRequested"
                Tapped="PlayerView_Tapped">
                <Border Background="Transparent" />
            </SwapChainPanel>
        </Grid>

        <local:PlayerControl
            x:Name="PlayerControl"
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            FullWindowButtonVisibility="Visible"
            NextTrackButtonVisibility="Visible"
            OnFullScreenRequest="PlayerControl_OnFullScreenRequest"
            OnFullWindowRequest="PlayerControl_OnFullWindowRequest"
            PreviousTrackButtonVisibility="Visible" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HidePlaylist">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="ShowPlaylist">
                    <VisualState.Setters>
                        <Setter Target="PlaylistContainer.Visibility" Value="Visible" />
                        <Setter Target="PlaylistColumn.Width" Value="1*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="NormalWindow">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="FullWindow">
                    <VisualState.Setters>
                        <Setter Target="PlayControlRow.Height" Value="0" />
                        <Setter Target="MenuRow.Height" Value="0" />
                        <Setter Target="PlayerControl.(Grid.Row)" Value="1" />
                        <Setter Target="PlaylistToolBar.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
