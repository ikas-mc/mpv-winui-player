<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="mpv_winui.Modules.Player.MpvPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                x:Name="MenuRow"
                Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition
                x:Name="PlayControlRow"
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition
                x:Name="PlaylistColumn"
                Width="0" />
        </Grid.ColumnDefinitions>
        <MenuBar
            Grid.Row="0"
            Grid.ColumnSpan="1">
            <MenuBarItem
                Title="File"
                Foreground="{ThemeResource SystemAccentColorLight3}"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open"
                    Text="Open File" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-folder"
                    Text="Open Folder" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-url"
                    Text="Open URL" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-clipboard"
                    Text="Open from Clipboard" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-dvd"
                    Text="Open DVD" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-bd"
                    Text="Open Blu-ray" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="load-subtitle"
                    Text="Add Subtitle" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot"
                    Text="Screenshot" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot-no-sub"
                    Text="Screenshot (No Subtitles)" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="restart"
                    Text="Restart" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="quit"
                    Text="Quit" />
            </MenuBarItem>

            <MenuBarItem
                Title="View"
                Foreground="{ThemeResource SystemAccentColorLight3}"
                IsTabStop="False">
                <ToggleMenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="playlist"
                    Text="Playlist" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullwindow"
                    Text="Full Window" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullscreen"
                    Text="Full Screen" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="conf-folder"
                    Text="Open Conf Folder" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="mpv-folder"
                    Text="Open mpv Folder" />
            </MenuBarItem>

            <MenuBarItem
                Title="Help"
                Foreground="{ThemeResource SystemAccentColorLight3}"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="about"
                    Text="About" />
            </MenuBarItem>
        </MenuBar>

        <Grid
            x:Name="PlaylistContainer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Canvas.ZIndex="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CommandBar
                Margin="8,0"
                x:Name="PlaylistToolBar"
                Grid.Row="0"
                Height="44"
                HorizontalAlignment="Right"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="False">
                <AppBarButton
                    Grid.Column="1"
                    Width="40"
                    Click="ClosePlaylist_Click"
                    Icon="ClosePane" />
                <AppBarButton
                    Grid.Column="1"
                    Width="40"
                    Click="RefreshPlaylist_Click"
                    Icon="Refresh" />
            </CommandBar>

            <ListView
                x:Name="PlaylistView"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                IsItemClickEnabled="True"
                ItemClick="PlaylistView_ItemClick"
                ItemsSource="{x:Bind PlaylistItems, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaylistItem">
                        <Grid Padding="4">
                            <TextBlock
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            AllowDrop="True"
            Background="#22000000"
            DragEnter="OnDragEnter"
            DragOver="OnDragOver"
            Drop="OnDrop">
            <SwapChainPanel
                x:Name="PlayerView"
                ContextRequested="PlayerView_ContextRequested"
                Tapped="PlayerView_Tapped">
                <Border Background="Transparent" />
            </SwapChainPanel>
        </Grid>

        <local:PlayerControl
            x:Name="PlayerControl"
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            FullWindowButtonVisibility="Visible"
            NextTrackButtonVisibility="Visible"
            OnFullScreenRequest="PlayerControl_OnFullScreenRequest"
            OnFullWindowRequest="PlayerControl_OnFullWindowRequest"
            PreviousTrackButtonVisibility="Visible" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HidePlaylist">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="ShowPlaylist">
                    <VisualState.Setters>
                        <Setter Target="PlaylistContainer.Visibility" Value="Visible" />
                        <Setter Target="PlaylistColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowOverPlaylist">
                    <VisualState.Setters>
                        <Setter Target="PlaylistContainer.Visibility" Value="Visible" />
                        <Setter Target="PlaylistContainer.(Grid.Column)" Value="0" />
                        <Setter Target="PlaylistContainer.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="NormalWindow">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="FullWindow">
                    <VisualState.Setters>
                        <Setter Target="PlayControlRow.Height" Value="0" />
                        <Setter Target="MenuRow.Height" Value="0" />
                        <Setter Target="PlayerControl.(Grid.Row)" Value="1" />
                        <Setter Target="PlaylistToolBar.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
