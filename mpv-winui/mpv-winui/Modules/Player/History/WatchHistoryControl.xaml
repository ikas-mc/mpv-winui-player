<UserControl
    x:Class="mpv_winui.Modules.Player.History.WatchHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:bc="using:mpv_winui.Modules.Common.Convertor"
    xmlns:local="using:mpv_winui.Modules.Player.History"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="False">
            <AppBarButton
                x:Name="ClearButton"
                Click="ClearButton_Click"
                Icon="Delete"
                Label="Clear" />
            <AppBarButton
                Click="RefreshButton_Click"
                Icon="Refresh"
                Label="Refresh" />
        </CommandBar>

        <ListView
            x:Name="HistoryListView"
            Grid.Row="1"
            IsItemClickEnabled="True"
            IsTabStop="False"
            ItemClick="HistoryListView_ItemClick"
            ItemsSource="{x:Bind Items}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style
                    BasedOn="{StaticResource DefaultListViewItemStyle}"
                    TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WatchHistoryItem">
                    <Grid
                        Height="32"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <FontIcon
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            FontSize="16"
                            Glyph="&#xE768;" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind bc:BindConvertor.FormatTime(Time)}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            FontSize="12"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Title}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            FontSize="12"
                            Text="{x:Bind Path}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyTextBlock"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.8"
            Text=""
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TeachingTip
            x:Name="ClearTeachingTip"
            ActionButtonClick="ClearTeachingTip_ActionButtonClick"
            ActionButtonContent="Yes"
            CloseButtonContent="No"
            IsLightDismissEnabled="True"
            Target="{x:Bind ClearButton}"
            Title="Clear history"
            Subtitle="Are you sure you want to clear the history?" />
    </Grid>
</UserControl>
