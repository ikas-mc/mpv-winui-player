<local:MpvConfOptionControlBase
    x:Class="mpv_winui.Modules.MpvConf.Option.MpvConfOptionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:mpv_winui.Modules.Common.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.MpvConf.Option"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:schema="using:mpv_winui.Modules.MpvConf.Schema"
    mc:Ignorable="d">

    <Grid
        Padding="8"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ctrl:CheckBoxExt
                x:Name="EnableCheck"
                Grid.Column="0"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                VerticalAlignment="Center"
                CheckChanged="OnEnableCheckChanged"
                ToolTipService.ToolTip="Enable / Remove" />
            <TextBlock
                x:Name="KeyText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="Bold"
                IsTextSelectionEnabled="True" />
            <FontIcon
                x:Name="ModifiedIcon"
                Grid.Column="2"
                Width="12"
                Height="12"
                Margin="0,4,0,0"
                VerticalAlignment="Center"
                FontSize="8"
                Foreground="#FFB900"
                Glyph="&#xE91F;"
                ToolTipService.ToolTip="Modified, not saved"
                Visibility="Collapsed" />
            <Border
                x:Name="GroupBadge"
                Grid.Column="3"
                Margin="0,0,0,0"
                Padding="4,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource SystemAccentColorLight2}"
                BorderThickness="1"
                CornerRadius="4">
                <TextBlock
                    x:Name="GroupText"
                    FontSize="11" />
            </Border>
            <Button
                x:Name="CopyButton"
                Grid.Column="4"
                Width="28"
                Height="24"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnCopyClicked"
                ToolTipService.ToolTip="Copy">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE8C8;" />
            </Button>
            <Button
                x:Name="ApplyButton"
                Grid.Column="5"
                Width="28"
                Height="24"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnApplyClicked"
                ToolTipService.ToolTip="Apply to player">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE724;" />
            </Button>
        </Grid>

        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="1"
            Margin="0,4,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            MaxLines="2"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />

        <Grid
            Grid.Row="2"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ctrl:CheckBoxExt
                x:Name="DisableCheck"
                Grid.Row="0"
                Grid.Column="0"
                MinWidth="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CheckChanged="OnDisableCheckChanged"
                Content="#"
                FlowDirection="RightToLeft"
                ToolTipService.ToolTip="Comment out (disable)" />
            <ComboBox
                x:Name="TypeBox"
                Grid.Row="0"
                Grid.Column="1"
                Width="120"
                Height="32"
                HorizontalAlignment="Left"
                SelectionChanged="OnTypeSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="schema:MpvConfSchemaItemValue">
                        <TextBlock Text="{x:Bind Type}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ToggleSwitch
                x:Name="BoolSwitch"
                Grid.Row="0"
                Grid.Column="2"
                Height="32"
                MinWidth="0"
                HorizontalAlignment="Left"
                OffContent="no"
                OnContent="yes"
                Style="{StaticResource LeftContentToggleSwitchStyle}"
                Toggled="OnBoolToggled"
                Visibility="Collapsed" />
            <ComboBox
                x:Name="EnumBox"
                Grid.Row="0"
                Grid.Column="2"
                Height="32"
                MinWidth="160"
                HorizontalAlignment="Left"
                SelectionChanged="OnEnumSelectionChanged"
                Visibility="Collapsed">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="schema:MpvConfSchemaEnumValue">
                        <TextBlock>
                            <Run Text="{x:Bind Value}" />
                            <Run Text=" - " />
                            <Run Text="{x:Bind Desc, FallbackValue=''}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <NumberBox
                x:Name="IntInput"
                Grid.Row="0"
                Grid.Column="2"
                Height="32"
                MinWidth="160"
                HorizontalAlignment="Left"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnIntChanged"
                Visibility="Collapsed" />
            <NumberBox
                x:Name="FloatInput"
                Grid.Row="0"
                Grid.Column="2"
                Height="32"
                MinWidth="160"
                HorizontalAlignment="Left"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnFloatChanged"
                Visibility="Collapsed" />
            <TextBox
                x:Name="TextInput"
                Grid.Row="0"
                Grid.Column="2"
                Height="32"
                MinWidth="200"
                HorizontalAlignment="Left"
                TextChanged="OnTextChanged"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</local:MpvConfOptionControlBase>
